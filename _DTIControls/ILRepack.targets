<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<!-- Enable/disable ILRepack merging -->
		<ILRepackEnabled Condition="'$(ILRepackEnabled)'==''">true</ILRepackEnabled>

		<!-- Internalize types from merged assemblies (makes them internal to prevent conflicts) -->
		<ILRepackInternalize Condition="'$(ILRepackInternalize)'==''">false</ILRepackInternalize>

		<!-- System assemblies and resource DLLs to exclude from merging -->
		<ILRepackExcludeFiles Condition="'$(ILRepackExcludeFiles)'==''">mscorlib.dll;System.dll;System.*.dll;netstandard.dll;*.resources.dll</ILRepackExcludeFiles>

		<!-- Temporary output file for merged assembly - use temp folder with correct assembly name -->
		<ILRepackOutputFile>$(TargetDir)temp_ilrepack\$(AssemblyName).dll</ILRepackOutputFile>
	</PropertyGroup>

	<!-- Main ILRepack merge target - runs after build completes -->
	<Target Name="ILRepackMerge"
			AfterTargets="Build"
			DependsOnTargets="ResolveReferences"
			Condition="'$(ILRepackEnabled)'=='true' and '$(IsCrossTargetingBuild)'!='true' and '$(TargetFrameworkIdentifier)'=='.NETFramework' and Exists('$(TargetPath)')">

		<!-- Locate .NET Framework reference assemblies directory -->
		<PropertyGroup>
			<_FxDir Condition="'$(TargetFrameworkRootPath)' != ''">$(TargetFrameworkRootPath)\.NETFramework\$(TargetFrameworkVersion)</_FxDir>
			<_FxDir Condition="'$(_FxDir)' == '' and Exists('$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\$(TargetFrameworkVersion)')">$(MSBuildProgramFiles32)\Reference Assemblies\Microsoft\Framework\.NETFramework\$(TargetFrameworkVersion)</_FxDir>
			<_RuntimeDir>$(MSBuildFrameworkToolsPath)\..</_RuntimeDir>
		</PropertyGroup>

		<!-- Build library search paths for ILRepack -->
		<ItemGroup>
			<!-- Include output directory -->
			<_LibPaths Include="$(TargetDir)" Condition="'$(TargetDir)' != ''" />

			<!-- Include .NET Framework reference assemblies -->
			<_LibPaths Include="$(_FxDir)" Condition="'$(_FxDir)' != '' and Exists('$(_FxDir)')" />
			<_LibPaths Include="$(_FxDir)\Facades" Condition="'$(_FxDir)' != '' and Exists('$(_FxDir)\Facades')" />

			<!-- Include .NET Framework runtime directory -->
			<_LibPaths Include="$(_RuntimeDir)" Condition="'$(_RuntimeDir)' != '' and Exists('$(_RuntimeDir)')" />

			<!-- Collect unique paths from all references -->
			<_LibPathFromRefs Include="@(ReferencePath->'%(RootDir)%(Directory)')" Condition="'%(RootDir)%(Directory)' != ''" />
		</ItemGroup>

		<!-- Remove duplicate library paths -->
		<RemoveDuplicates Inputs="@(_LibPathFromRefs)">
			<Output TaskParameter="Filtered" ItemName="_LibPathFromRefsU"/>
		</RemoveDuplicates>

		<ItemGroup>
			<_LibPaths Include="@(_LibPathFromRefsU)" Condition="'%(Identity)' != ''" />
		</ItemGroup>

		<!-- Collect all assemblies to merge -->
		<ItemGroup>
			<!-- Start with the primary output assembly (DTIControls.dll) -->
			<_InputCandidates Include="$(TargetPath)" />

			<!-- Add all referenced assemblies from ReferencePath (includes Private=False references) -->
			<_InputCandidates Include="@(ReferencePath)" Condition="'%(ReferencePath.Extension)'=='.dll'"/>
		</ItemGroup>

		<!-- Remove duplicate assemblies -->
		<RemoveDuplicates Inputs="@(_InputCandidates)">
			<Output TaskParameter="Filtered" ItemName="_ToMergeRaw"/>
		</RemoveDuplicates>

		<!-- Filter out system assemblies, resource DLLs, and database-specific helpers (but keep SQLHelper.dll).
		     Microsoft.Data.SqlClient and its AAD/identity dependency closure (Azure.*, Microsoft.Identity*,
		     Microsoft.IdentityModel.*, Microsoft.Bcl.AsyncInterfaces) are also excluded: on .NET Framework the
		     ILMerged provider loses internal static state and throws NullReferenceException from inside
		     SqlConnection.get_ConnectionString() and SqlDataAdapter update commands. They deploy side-by-side
		     from _Output instead. -->
		<ItemGroup>
			<_ToMergeFiltered Include="@(_ToMergeRaw)"
					  Exclude="**\*.resources.dll;
							   **\mscorlib.dll;
							   **\System.*.dll;
							   **\FxResources.*.dll;
							   **\netstandard.dll;
							   **\WindowsBase.dll;
							   **\PresentationCore.dll;
							   **\PresentationFramework.dll;
							   **\Microsoft.VisualBasic.dll;
							   **\Microsoft.CSharp.dll;
							   **\Microsoft.Build.*.dll;
							   **\Microsoft.Win32.*.dll;
							   **\SQLiteHelper.dll;
							   **\System.Data.SQLite.dll;
							   **\System.Data.SQLite.*.dll;
							   **\Oracle.*.dll;
							   **\MySql.*.dll;
							   **\mySQLHelper.dll;
							   **\OracleHelper.dll;
								   **\Microsoft.Data.SqlClient.dll;
								   **\Microsoft.Data.SqlClient.*.dll;
								   **\Azure.*.dll;
								   **\Microsoft.Identity.Client.dll;
								   **\Microsoft.Identity.Client.*.dll;
								   **\Microsoft.IdentityModel.*.dll;
								   **\Microsoft.Bcl.AsyncInterfaces.dll;
							   $(ILRepackExcludeFiles)"/>

			<!-- Additional filtering: exclude framework assemblies but INCLUDE NuGet Microsoft.* packages and System.ValueTuple.dll -->
			<_ToMerge Include="@(_ToMergeFiltered)"
					  Condition="Exists('%(FullPath)')
					  and (!$([System.IO.Path]::GetFileName('%(FullPath)').StartsWith('System.')) or $([System.IO.Path]::GetFileName('%(FullPath)')) == 'System.ValueTuple.dll')
					  and !$([System.IO.Path]::GetFileName('%(FullPath)').StartsWith('FxResources.'))
					  and !$([System.IO.Path]::GetFileName('%(FullPath)').StartsWith('SQLite'))
					  and !$([System.IO.Path]::GetFileName('%(FullPath)').StartsWith('Oracle'))
					  and !$([System.IO.Path]::GetFileName('%(FullPath)').StartsWith('MySql'))
					  and !$([System.IO.Path]::GetFileName('%(FullPath)').StartsWith('Microsoft.Data.SqlClient'))
					  and !$([System.IO.Path]::GetFileName('%(FullPath)').StartsWith('Azure.'))
					  and !$([System.IO.Path]::GetFileName('%(FullPath)').StartsWith('Microsoft.Identity'))
					  and !$([System.IO.Path]::GetFileName('%(FullPath)').StartsWith('Microsoft.Bcl.'))
					  and !$([System.IO.Path]::GetDirectoryName('%(FullPath)').Contains('Reference Assemblies'))
					  and !$([System.IO.Path]::GetDirectoryName('%(FullPath)').Contains('Microsoft.NET\Framework'))
					  and $([System.IO.Path]::GetFileName('%(FullPath)')) != 'mscorlib.dll'
					  and $([System.IO.Path]::GetFileName('%(FullPath)')) != 'netstandard.dll'
					  and $([System.IO.Path]::GetFileName('%(FullPath)')) != 'WindowsBase.dll'
					  and $([System.IO.Path]::GetFileName('%(FullPath)')) != 'Microsoft.VisualBasic.dll'
					  and $([System.IO.Path]::GetFileName('%(FullPath)')) != 'Microsoft.CSharp.dll'
					  and $([System.IO.Path]::GetFileName('%(FullPath)')) != 'SQLiteHelper.dll'
					  and $([System.IO.Path]::GetFileName('%(FullPath)')) != 'mySQLHelper.dll'
					  and $([System.IO.Path]::GetFileName('%(FullPath)')) != 'OracleHelper.dll'" />
		</ItemGroup>

		<!-- Ensure output file has absolute path -->
		<PropertyGroup>
			<_ILRepackOutputFileAbsolute>$([System.IO.Path]::GetFullPath('$(ILRepackOutputFile)'))</_ILRepackOutputFileAbsolute>
			<_ILRepackTempDir>$([System.IO.Path]::GetDirectoryName('$(_ILRepackOutputFileAbsolute)'))</_ILRepackTempDir>
		</PropertyGroup>

		<!-- Create temp directory for ILRepack output -->
		<MakeDir Directories="$(_ILRepackTempDir)" Condition="!Exists('$(_ILRepackTempDir)')" />

		<!-- Display what we're merging (for debugging) -->
		<Message Text="ILRepack: Merging @(_ToMerge->Count()) assemblies into $(AssemblyName).dll" Importance="high" />
		<Message Text="ILRepack: Including: %0d%0a  @(_ToMerge, '%0d%0a  ')" Importance="high" Condition="'@(_ToMerge)' != ''" />
		<Message Text="ILRepack: OutputFile=$(_ILRepackOutputFileAbsolute)" Importance="high" />
		<Message Text="ILRepack: LibraryPaths=%0d%0a  @(_LibPaths, '%0d%0a  ')" Importance="high" />

		<!-- Execute ILRepack to merge assemblies -->
		<ILRepack
			InputAssemblies="@(_ToMerge)"
			OutputFile="$(_ILRepackOutputFileAbsolute)"
			TargetKind="Dll"
			Internalize="$(ILRepackInternalize)"
			XmlDocumentation="true"
			DebugInfo="true"
			LibraryPath="@(_LibPaths)"
			Wildcards="false"
			Parallel="true"
			Verbose="true" />

		<!-- Determine file paths for PDB and XML documentation -->
		<PropertyGroup>
			<_MergedPdb>$([System.IO.Path]::ChangeExtension('$(_ILRepackOutputFileAbsolute)', '.pdb'))</_MergedPdb>
			<_MergedXml>$([System.IO.Path]::ChangeExtension('$(_ILRepackOutputFileAbsolute)', '.xml'))</_MergedXml>
			<_TargetPdb>$([System.IO.Path]::ChangeExtension('$(TargetPath)', '.pdb'))</_TargetPdb>
			<_TargetXml>$([System.IO.Path]::ChangeExtension('$(TargetPath)', '.xml'))</_TargetXml>
		</PropertyGroup>

		<!-- Replace original files with merged versions -->
		<Copy SourceFiles="$(_ILRepackOutputFileAbsolute)" DestinationFiles="$(TargetPath)" OverwriteReadOnlyFiles="true" />
		<Copy Condition="Exists('$(_MergedPdb)')" SourceFiles="$(_MergedPdb)" DestinationFiles="$(_TargetPdb)" OverwriteReadOnlyFiles="true" />
		<Copy Condition="Exists('$(_MergedXml)')" SourceFiles="$(_MergedXml)" DestinationFiles="$(_TargetXml)" OverwriteReadOnlyFiles="true" />

		<!-- Clean up temporary merged files and directory -->
		<Delete Files="$(_ILRepackOutputFileAbsolute)" />
		<Delete Files="$(_MergedPdb)" Condition="Exists('$(_MergedPdb)')" />
		<Delete Files="$(_MergedXml)" Condition="Exists('$(_MergedXml)')" />
		<RemoveDir Directories="$(_ILRepackTempDir)" Condition="Exists('$(_ILRepackTempDir)')" />

		<Message Text="ILRepack: Successfully merged assemblies into $(TargetPath)" Importance="high" />
	</Target>
</Project>
